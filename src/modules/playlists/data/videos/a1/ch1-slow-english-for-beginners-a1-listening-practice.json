  "breakdowns": [
    {
      "id": "grammar-1",
      "sentence": "[Music] Hello, my name is Tyana Ortiz.",
      "translation": "這個 podcast 是給想透過聽英文來學習的初學者。",
      "points": [
        {
          "label": "Grammar 1",
          "text": "who 引出補充說明，說明是想學習的初學者。",
          "note": "這個 podcast 是給想透過聽英文來學習的初學者。"
        }
      ]
    },
    {
      "id": "grammar-2",
      "sentence": "Welcome to my slow podcast.",
      "translation": "透過聽英文來學習。",
      "points": [
        {
          "label": "Grammar 2",
          "text": "by 後面接動名詞，表示透過某種方式。",
          "note": "透過聽英文來學習。"
        }
      ]
    },
    {
      "id": "grammar-3",
      "sentence": "This podcast is for beginners who want to learn by listening to English.",
      "translation": "routine 是你每天會做的事情。",
      "points": [
        {
          "label": "Grammar 3",
          "text": "that 當受詞時可以省略，後面說明 something 是什麼。",
          "note": "routine 是你每天會做的事情。"
        }
      ]
    },
    {
      "id": "grammar-4",
      "sentence": "Today's podcast is about my daily routine.",
      "translation": "教學後，我讀書。",
      "points": [
        {
          "label": "Grammar 4",
          "text": "after 當介系詞時，後面可接動名詞表示在做完某事後。",
          "note": "教學後，我讀書。"
        }
      ]
    },
    {
      "id": "grammar-5",
      "sentence": "My daily routine.",
      "translation": "你早餐通常吃什麼？",
      "points": [
        {
          "label": "Grammar 5",
          "text": "一般現在式問句用 do 幫忙形成問題。",
          "note": "你早餐通常吃什麼？"
        }
      ]
    },
    {
      "id": "grammar-6",
      "sentence": "A routine is something you do every day.",
      "translation": "我喜歡每天伸展。",
      "points": [
        {
          "label": "Grammar 6",
          "text": "stretching 是被喜歡的活動，所以用動名詞放在 love 後面。",
          "note": "我喜歡每天伸展。"
        }
      ]
    },
    {
      "id": "grammar-7",
      "sentence": "In the morning, I wake up at 7 a.m. I brush my teeth.",
      "translation": "你喜歡跳舞嗎？",
      "points": [
        {
          "label": "Grammar 7",
          "text": "to dance 表示去跳舞這個活動，可放在 like 後面。",
          "note": "你喜歡跳舞嗎？"
        }
      ]
    },
    {
      "id": "grammar-8",
      "sentence": "I wash my face, and I eat breakfast.",
      "translation": "你和誰一起工作？",
      "points": [
        {
          "label": "Grammar 8",
          "text": "口語英文常把 with 留在句尾，詢問和誰一起做某事。",
          "note": "你和誰一起工作？"
        }
      ]
    }
  ]
