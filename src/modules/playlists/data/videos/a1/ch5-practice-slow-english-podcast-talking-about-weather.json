  "breakdowns": [
    {
      "id": "grammar-1",
      "sentence": "Hello, and welcome back to my slow English podcast, a podcast to practice English listening for beginners.",
      "translation": "你好，歡迎回到我的慢速英語 podcast，這是一個給初學者練習英文聽力的 podcast。",
      "points": [
        {
          "label": "to 不定詞表示用途",
          "text": "名詞 + to + 原形動詞",
          "note": "用 to practice 說明這個 podcast 的用途。"
        }
      ]
    },
    {
      "id": "grammar-2",
      "sentence": "When it rains, I usually stay inside.",
      "translation": "下雨時，我通常待在室內。",
      "points": [
        {
          "label": "when 引導時間副詞子句",
          "text": "When + 主詞 + 動詞, 主詞 + 動詞",
          "note": "先說「什麼時候」，再說那時通常會做什麼。"
        }
      ]
    },
    {
      "id": "grammar-3",
      "sentence": "I love when it's hot.",
      "translation": "我喜歡天氣熱的時候。",
      "points": [
        {
          "label": "when 子句作受詞",
          "text": "love + when + 主詞 + 動詞",
          "note": "用整個 when 子句當 love 的內容，表示喜歡某種情況。"
        }
      ]
    },
    {
      "id": "grammar-4",
      "sentence": "In my city, it doesn't snow.",
      "translation": "在我的城市，不會下雪。",
      "points": [
        {
          "label": "天氣用虛主詞 it",
          "text": "it + 天氣動詞",
          "note": "英文談天氣常用 it 當主詞，it 不指特定東西。"
        }
      ]
    },
    {
      "id": "grammar-5",
      "sentence": "I used to live in Nebraska, United States.",
      "translation": "我以前住在美國內布拉斯加州。",
      "points": [
        {
          "label": "used to + 原形動詞",
          "text": "主詞 + used to + 原形動詞",
          "note": "表示過去曾經如此，現在不一定如此。"
        }
      ]
    },
    {
      "id": "grammar-6",
      "sentence": "What's the weather like in your city?",
      "translation": "你城市的天氣如何？",
      "points": [
        {
          "label": "What is ... like? 問狀況",
          "text": "What + be 動詞 + 名詞 + like?",
          "note": "用 like 問「是什麼樣子」或「狀況如何」。"
        }
      ]
    },
    {
      "id": "grammar-7",
      "sentence": "Try to pause the video, and try not to read the subtitles.",
      "translation": "試著暫停影片，並試著不要看字幕。",
      "points": [
        {
          "label": "try to V / try not to V",
          "text": "try + to + 原形動詞；try + not + to + 原形動詞",
          "note": "表示「試著做某事」或「試著不要做某事」。"
        }
      ]
    },
    {
      "id": "grammar-8",
      "sentence": "Don't forget to like and subscribe for more content.",
      "translation": "別忘了按讚並訂閱更多內容。",
      "points": [
        {
          "label": "否定祈使句 + forget to V",
          "text": "Don't + 原形動詞；forget + to + 原形動詞",
          "note": "用來提醒對方不要忘記做某件事。"
        }
      ]
    }
  ]
}
