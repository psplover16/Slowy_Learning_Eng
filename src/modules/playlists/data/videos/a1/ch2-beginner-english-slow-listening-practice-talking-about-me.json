  "breakdowns": [
    {
      "id": "grammar-1",
      "sentence": "What I love most about Mexico are the people and the food.",
      "translation": "我最喜歡墨西哥的是那裡的人和食物。",
      "points": [
        {
          "label": "What 引導的名詞子句作主詞",
          "text": "What + 主詞 + 動詞 + 副詞/介系詞片語 + be + 補語",
          "note": "what 子句把「我最喜歡的事物」包成主詞，後面用 be 連接答案。"
        }
      ]
    },
    {
      "id": "grammar-2",
      "sentence": "I usually celebrate surrounded by my family and friends.",
      "translation": "我通常會在家人和朋友的陪伴中慶祝。",
      "points": [
        {
          "label": "過去分詞片語作補充說明",
          "text": "主詞 + 動詞 + 過去分詞片語",
          "note": "surrounded by 說明慶祝時的狀態，相當於 while I am surrounded by my family and friends。"
        }
      ]
    },
    {
      "id": "grammar-3",
      "sentence": "I like surrounding myself with people who love love me.",
      "translation": "我喜歡讓自己身邊都是愛、愛我的人。",
      "points": [
        {
          "label": "動名詞片語作受詞",
          "text": "like + V-ing + 受詞/補語",
          "note": "動詞 like 後面可以接 V-ing 當受詞，表示喜歡做某件事。"
        }
      ]
    },
    {
      "id": "grammar-4",
      "sentence": "I like surrounding myself with people who love love me. / Purple reminds me of the flowers, the flowers that bloom in the spring.",
      "translation": "我喜歡讓自己身邊都是愛、愛我的人。/ 紫色讓我想起花朵，那些在春天盛開的花朵。",
      "points": [
        {
          "label": "關係子句",
          "text": "名詞 + who/that + 動詞",
          "note": "who 或 that 後面的子句補充說明前面的名詞 people 或 flowers。"
