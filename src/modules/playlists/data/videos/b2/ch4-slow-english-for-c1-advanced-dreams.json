      "id": "scene-12",
      "no": "12",
      "titleZh": "第 12 段",
      "titleEn": "Part 12",
      "sentences": [
        {
          "en": "If you disagree, tell me the reason.",
          "tc": "如果您不同意，請告訴我原因。",
          "englishTokens": [
            {
              "type": "text",
              "text": "If you disagree, tell me the reason."
            }
          ]
        },
        {
          "en": "Some recurring dreams that I have had before are dreams where all my teeth are falling out.",
          "tc": "我以前常做的一些夢是我所有的牙齒都掉光的夢。",
          "englishTokens": [
            {
              "type": "text",
              "text": "Some "
