  "breakdowns": [
    {
      "id": "grammar-1",
      "sentence": "Hello, welcome back to my Slow English podcast, a podcast to practice your English listening for upper-intermediate level.",
      "translation": "您好，歡迎回到我的慢速英語podcast，這是一​​個練習中高級英語聽力的podcast。",
      "points": [
        {
          "label": "to 不定詞",
          "text": "to + 原形動詞",
          "note": "用來表示目的、補語或接在特定動詞後。"
        }
      ]
    },
    {
      "id": "grammar-2",
      "sentence": "When I think of my comfort food, the first thing that comes to mind is Flamin' Hot Cheetos.",
      "translation": "當我想到安慰食物時，我首先想到的是 Flamin' Hot Cheetos。",
      "points": [
        {
          "label": "that 引導名詞子句或關係子句",
          "text": "that + 子句",
          "note": "that 用來補充說明前面的想法或名詞。"
        }
      ]
    },
    {
      "id": "grammar-3",
      "sentence": "Since I was a little girl, my sister and I have always enjoyed a big bag of Flamin' Hot Cheetos while watching cartoons or movies together.",
      "translation": "從我還是個小女孩的時候起，我和妹妹就總是一邊看卡通片或電影一邊享用一大袋 Flamin' Hot Cheetos。",
      "points": [
        {
          "label": "while + V-ing / 子句",
          "text": "while + 動作",
          "note": "表示兩個動作同時發生。"
        }
      ]
    },
    {
      "id": "grammar-4",
      "sentence": "They can't stand spicy food, and I used to agree.",
      "translation": "他們不能忍受辛辣的食物，我以前也同意。",
      "points": [
        {
          "label": "used to + 原形動詞",
          "text": "used to + V",
          "note": "表示過去常做或過去曾經如此，現在可能不同。"
        }
      ]
    },
    {
      "id": "grammar-5",
      "sentence": "I would just cry and sniffle, but now I can't get enough of it.",
      "translation": "我本來會哭、抽鼻子，但現在我怎麼也受不了。",
      "points": [
        {
          "label": "would 表示假設或委婉語氣",
          "text": "would + 原形動詞",
          "note": "用來談假設、過去習慣或較委婉的說法。"
        }
      ]
    },
    {
      "id": "grammar-6",
      "sentence": "If you do, what are your favorite dishes?",
      "translation": "如果有的話，你最喜歡的菜是什麼？",
      "points": [
        {
          "label": "if 條件句",
          "text": "If + 子句, 主句",
          "note": "用 if 帶出條件，再說明在此條件下的結果。"
        }
      ]
    },
    {
      "id": "grammar-7",
      "sentence": "When I was younger, I used to sneak into the kitchen to steal the sweets, the bread my father had put there.",
      "translation": "當我年輕的時候，我常常偷偷溜進廚房偷我父親放在那裡的糖果和麵包。",
      "points": [
        {
          "label": "when 時間子句",
          "text": "when + 主詞 + 動詞",
          "note": "用 when 說明事情發生的時間或情境。"
