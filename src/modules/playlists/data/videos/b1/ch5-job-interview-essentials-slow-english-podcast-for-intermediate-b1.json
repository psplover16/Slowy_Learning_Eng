  "breakdowns": [
    {
      "id": "grammar-1",
      "sentence": "Today, I want to practice some common job interview vocabulary, some different phrases you might need at a job interview, and a story about my experience with job interviews.",
      "translation": "一些你在求職面試中可能會需要的不同片語",
      "points": [
        {
          "label": "關係代名詞省略",
          "text": "phrases + (that/which) + you might need",
          "note": "you might need 前面省略了 that 或 which，用來補充說明 phrases 是「你可能會需要的」片語。"
        }
      ]
    },
    {
      "id": "grammar-2",
      "sentence": "Any new qualifications, experience, or employment positions, I add to my CV resume right away.",
      "translation": "任何新的資格、經驗或工作職位，我都會立刻加到我的履歷裡。",
      "points": [
        {
          "label": "前置受詞",
          "text": "Object + subject + verb",
          "note": "把受詞放到句首強調「任何新的資格、經驗或職位」，後面再說明我會把它們加進履歷。"
        }
      ]
    },
    {
      "id": "grammar-3",
      "sentence": "I have only ever been an English teacher.",
      "translation": "我一直都只是英文老師。",
      "points": [
        {
          "label": "現在完成式搭配 ever/never/only ever",
          "text": "subject + have/has + adverb + past participle",
          "note": "用現在完成式談到目前為止的人生經驗；only ever 強調「一直以來只」。"
        }
      ]
    },
    {
      "id": "grammar-4",
      "sentence": "It is one of my greatest strengths to be able to communicate very well with others.",
      "translation": "能夠和別人非常良好地溝通，是我最大的優點之一。",
      "points": [
        {
          "label": "It is + 名詞 + to V",
          "text": "It + be + noun phrase + to + verb",
          "note": "It 是形式主詞，真正的主詞是後面的 to be able to communicate very well with others。"
        }
      ]
    },
    {
      "id": "grammar-5",
      "sentence": "Some weaknesses of mine, however, are the idea that I can do everything in one moment.",
      "translation": "我的一些弱點是我會覺得自己可以在同一個時刻做所有事。",
      "points": [
        {
          "label": "同位語子句 that",
          "text": "idea + that + subject + verb",
          "note": "that 子句說明 idea 的具體內容，也就是「我可以在同一個時刻做所有事」這個想法。"
        }
      ]
    },
    {
      "id": "grammar-6",
      "sentence": "Now I try to limit myself so that I don't end up feeling overworked and tired.",
      "translation": "現在我試著限制自己，這樣我才不會最後覺得工作過度又疲累。",
      "points": [
        {
          "label": "目的子句 so that",
          "text": "main clause + so that + subject + verb",
          "note": "so that 引導目的，說明我限制自己的原因是為了不要最後感到過勞和疲累。"
        }
      ]
    },
    {
      "id": "grammar-7",
      "sentence": "Have you ever ended up feeling overworked and exhausted?",
      "translation": "你曾經最後覺得工作過度又精疲力盡嗎？",
      "points": [
        {
          "label": "現在完成式疑問句",
          "text": "Have/Has + subject + past participle...?",
          "note": "用來詢問到目前為止的人生經驗，ever 強調「曾經」。"
        }
      ]
    },
    {
      "id": "grammar-8",
      "sentence": "But just as it feels nice to be hired, it feels really bad to be fired.",
      "translation": "就像被錄取感覺很好一樣，被解雇的感覺真的很糟。",
      "points": [
        {
          "label": "被動不定詞",
          "text": "to be + past participle",
          "note": "to be hired 和 to be fired 表示「被錄取」和「被解雇」，重點在承受動作的人。"
        }
      ]
    },
    {
      "id": "grammar-9",
      "sentence": "Whether you're hired or fired, you are not a failure.",
      "translation": "不管你是被錄取還是被解雇，你都不是失敗者。",
      "points": [
