              "type": "word",
              "text": "failure",
              "targetId": "word-failure",
              "instanceId": "marker-b1-ch5-job-interview-essentials-slow-english-podcast-for-intermediate-b1-030-03"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        },
        {
          "en": "Success is a feeling you can give yourself.",
          "tc": "成功是一種你可以給自己的感覺。",
          "englishTokens": [
            {
              "type": "word",
