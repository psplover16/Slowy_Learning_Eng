              "type": "usage",
              "text": "give",
              "targetId": "usage-give-give-yourself-a-feeling",
              "instanceId": "marker-b1-ch5-job-interview-essentials-slow-english-podcast-for-intermediate-b1-031-02"
            },
            {
              "type": "text",
              "text": " yourself."
