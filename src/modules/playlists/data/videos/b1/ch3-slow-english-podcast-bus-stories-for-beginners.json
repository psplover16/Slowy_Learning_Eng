  "breakdowns": [
    {
      "id": "grammar-1",
      "sentence": "Hello, welcome back to my slow English podcast, a podcast for you to practice your English listening skills.",
      "translation": "哈囉，歡迎回到我的慢速英語 podcast，這是一個讓你練習英語聽力技巧的 podcast。",
      "points": [
        {
          "label": "同位語與 for someone to V",
          "text": "名詞 + , + 同位語 + for + 人 + to + 原形動詞",
          "note": "逗號後的 a podcast 補充說明前面的 podcast；for you to practice 表示這個 podcast 的用途是讓你練習。"
        }
      ]
    },
    {
      "id": "grammar-2",
      "sentence": "My friend and I had to get home, so we waited for the bus to come for maybe 10 minutes until, finally, it arrived.",
      "translation": "我和朋友得回家，所以我們等公車來，可能等了 10 分鐘，直到它終於到了。",
      "points": [
        {
          "label": "have to + 原形動詞；until 時間子句",
          "text": "S + had to + V, so S + V + until + S + V",
          "note": "had to 表示過去必須做某事；until 引導時間子句，表示動作一直持續到某個時間點。"
        }
      ]
    },
    {
      "id": "grammar-3",
      "sentence": "At that point, we had already waited 20 minutes.",
      "translation": "到那個時候，我們已經等了 20 分鐘。",
      "points": [
        {
          "label": "過去完成式",
          "text": "S + had + already + past participle",
          "note": "had already waited 表示在過去某個時間點之前，等待這件事已經發生並持續了一段時間。"
        }
      ]
    },
    {
      "id": "grammar-4",
      "sentence": "I wasn't waiting any longer, so we got on the bus, and we fit just right.",
      "translation": "我不想再等下去了，所以我們上了公車，而且我們剛好擠得進去。",
      "points": [
        {
          "label": "過去進行式否定",
          "text": "S + was not + V-ing",
          "note": "wasn't waiting 表示說話者在過去那個時候不想繼續等待，強調當時正在進行或即將持續的狀態。"
        }
      ]
    },
    {
      "id": "grammar-5",
      "sentence": "I had to hold on so tightly so that I wouldn't fall or trip.",
      "translation": "我必須緊緊抓住，這樣才不會跌倒或絆倒。",
      "points": [
        {
          "label": "so that 目的子句",
          "text": "S + V + so that + S + would not + V",
          "note": "so that 引導目的，說明前面的動作是為了避免後面的結果發生。"
        }
      ]
    },
    {
      "id": "grammar-6",
      "sentence": "They were very short, so the two boys could not hold on to any of the handles, so they were going side to side, falling and tripping.",
      "translation": "他們很矮，所以那兩個男孩抓不到任何把手，所以他們左右搖晃，跌跌撞撞。",
      "points": [
        {
          "label": "could not + 原形動詞；分詞片語補充動作",
          "text": "S + could not + V, so S + was/were + V-ing, V-ing and V-ing",
          "note": "could not hold on 表示沒有能力抓住；falling and tripping 補充說明他們左右搖晃時同時發生的動作。"
        }
      ]
    },
    {
      "id": "grammar-7",
      "sentence": "We all rode like sardines the whole way home, and once we finally arrived, we all said, 'Goodbye, nice to meet you,' and it was a very nice experience.",
      "translation": "我們一路上都像沙丁魚一樣擠著搭車回家；等我們終於到達時，我們都說：「再見，很高興認識你」，那真是一次非常好的經驗。",
      "points": [
        {
          "label": "once 引導時間子句",
          "text": "once + S + V, S + V",
          "note": "once 表示一旦或當某件事發生時，用來連接先後發生的兩個動作。"
        }
      ]
    },
    {
      "id": "grammar-8",
      "sentence": "I love being in Mexico, where you can see all kinds of nice actions every day, without a doubt.",
      "translation": "我喜歡待在墨西哥，在那裡你每天都可以看見各式各樣美好的舉動，毫無疑問。",
      "points": [
        {
          "label": "動名詞作受詞；where 關係子句",
          "text": "love + V-ing；地點名詞 + where + S + V",
          "note": "love 後面可接 V-ing 表示喜歡做某事；where 子句補充說明 Mexico 這個地方有什麼特色。"
        }
      ]
    },
    {
      "id": "grammar-9",
      "sentence": "Tell me about a nice experience you've had with complete strangers.",
      "translation": "告訴我一個你和完全陌生的人之間有過的美好經驗。",
      "points": [
        {
          "label": "現在完成式",
          "text": "S + have/has + past participle",
          "note": "you've had 表示從過去到現在曾經有過的經驗，重點在經驗本身，而不是明確的過去時間。"
        }
      ]
    },
    {
      "id": "grammar-10",
      "sentence": "Describe how it made you feel and why it was so special, but also, also so normal.",
      "translation": "描述它讓你有什麼感覺，以及它為什麼那麼特別，但也、也那麼平常。",
      "points": [
        {
          "label": "how 與 why 引導的名詞子句",
          "text": "describe + how + S + V + and + why + S + V",
          "note": "how it made you feel 和 why it was so special 都是 describe 的受詞，用來說明要描述的內容。"
        }
      ]
    }
  ],
