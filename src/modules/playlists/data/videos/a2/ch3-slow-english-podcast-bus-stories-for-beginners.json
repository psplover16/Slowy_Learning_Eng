  "breakdowns": [
    {
      "id": "grammar-1",
      "sentence": "My friend and I had to get home.",
      "translation": "我和我的朋友必須回家。",
      "points": [
        {
          "label": "have to + 原形動詞",
          "text": "had to + get",
          "note": "表示過去有必要做某事；這裡表示他們當時必須回家。"
        }
      ]
    },
    {
      "id": "grammar-2",
      "sentence": "We waited for the bus to come for maybe 10 minutes until finally it arrived.",
      "translation": "我們等公車來，大概等了 10 分鐘，直到它終於到了。",
      "points": [
        {
          "label": "until 引導時間子句",
          "text": "main clause + until + subject + verb",
          "note": "用 until 說明等待一直持續到公車到達為止。"
        }
      ]
    },
    {
      "id": "grammar-3",
      "sentence": "It was so packed full of people.",
      "translation": "車上擠滿了人。",
      "points": [
        {
          "label": "so + 形容詞",
          "text": "so + adjective phrase",
          "note": "so 加形容詞可加強程度，表示非常擁擠。"
        }
      ]
    },
    {
      "id": "grammar-4",
      "sentence": "We had already waited 20 minutes.",
      "translation": "我們已經等了 20 分鐘。",
      "points": [
        {
          "label": "過去完成式",
          "text": "had + already + past participle",
          "note": "用來表示在另一個過去時間點之前已經完成的事。"
        }
      ]
    },
    {
      "id": "grammar-5",
      "sentence": "I wasn't waiting any longer.",
      "translation": "我不想再等了。",
      "points": [
        {
          "label": "過去進行式否定",
          "text": "was not + V-ing",
          "note": "表示當時那個狀態或動作不再繼續，也帶出口語上的決定感。"
        }
      ]
    },
    {
      "id": "grammar-6",
      "sentence": "I had to hold on so tight so that I wouldn't fall or trip.",
      "translation": "我必須抓得很緊，這樣才不會跌倒或絆倒。",
      "points": [
        {
          "label": "so that + would",
          "text": "so that + subject + would not + verb",
          "note": "用 so that 說明目的；wouldn't 表示在那個情況下避免發生的結果。"
        }
      ]
    },
    {
      "id": "grammar-7",
      "sentence": "Once we finally arrived, we all said goodbye.",
      "translation": "終於到站後，我們都道別。",
      "points": [
        {
          "label": "once 引導時間子句",
          "text": "once + subject + verb, main clause",
          "note": "once 表示「一旦、當……之後」，用來說明到站之後才發生道別。"
        }
      ]
    },
    {
      "id": "grammar-8",
      "sentence": "I love being in Mexico, where you can see all kinds of nice actions every day.",
