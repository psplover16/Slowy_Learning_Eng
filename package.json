{
  "name": "slowy-learning-eng",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.vue",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
