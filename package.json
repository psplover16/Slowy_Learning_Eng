    "test:ci": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:e2e",
    "misshoney:import": "node scripts/misshoney/import-playlists.mjs",
    "misshoney:fetch-transcript": "node scripts/misshoney/fetch-transcript.mjs",
    "misshoney:scaffold-content": "node scripts/misshoney/scaffold-content.mjs",
    "misshoney:author-polished-content": "node scripts/misshoney/author-polished-content.mjs",
    "misshoney:parse-proofread": "node scripts/misshoney/parse-proofread-result.mjs",
    "misshoney:full-refresh": "node scripts/misshoney/full-refresh.mjs",
    "misshoney:validate-content": "node scripts/misshoney/validate-content.mjs",
    "misshoney:promote-content": "node scripts/misshoney/promote-content.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-safe-area": "^0.8.0",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.3",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.10"
  }
